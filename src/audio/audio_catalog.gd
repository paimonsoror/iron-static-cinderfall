class_name AudioCatalog
extends RefCounted
## The sound ids of ARCH 10 and their mix settings. Files are generated by tools/audio_gen/gen.py.
##
## PARAMS row = [volume_db, pitch_jitter, min_interval_ms, priority]
##  - volume_db: mix gain on top of the file (files are normalized to about -1 dBFS);
##  - pitch_jitter: pitch_scale varies by +/- this fraction (from the director's own RNG);
##  - min_interval_ms: the same id may not start again sooner than this;
##  - priority: when all 16 voices are busy a sound may take the voice of an equal or lower priority (oldest first).

const SFX_DIR: String = "res://assets/audio/sfx/"
const LOOP_AMBIENCE: String = "res://assets/audio/loops/ambience.wav"
const LOOP_DRONE: String = "res://assets/audio/loops/combat_drone.wav"

const PRIORITY_LOW: int = 0
const PRIORITY_MID: int = 1
const PRIORITY_HIGH: int = 2

## ARCH 10, in that order.
const IDS: Array[StringName] = [
	&"shot_pistol", &"shot_smg", &"shot_turret", &"reload_start", &"reload_done", &"hit_ceramic", &"hit_armor",
	&"death_small", &"death_heavy", &"death_boss", &"core_hit_light", &"core_hit_heavy", &"boss_stomp", &"emp",
	&"shield_up", &"shield_break", &"overdrive_on", &"overdrive_off", &"ui_tap", &"ui_purchase", &"ui_deny",
	&"ui_drawer", &"wave_start", &"wave_clear", &"intermission_tick", &"core_low", &"boss_stinger", &"victory",
	&"defeat",
]

## Sounds that may be longer than 1.5 s.
const STINGERS: Array[StringName] = [&"boss_stinger", &"victory", &"defeat"]

const PARAMS: Dictionary = {
	&"shot_pistol": [-5.0, 0.035, 90, 0],
	&"shot_smg": [-7.0, 0.040, 55, 0],
	&"shot_turret": [-8.0, 0.040, 80, 0],
	&"reload_start": [-6.0, 0.020, 200, 1],
	&"reload_done": [-5.0, 0.020, 200, 1],
	&"hit_ceramic": [-11.0, 0.060, 60, 0],
	&"hit_armor": [-10.0, 0.060, 60, 0],
	&"death_small": [-8.0, 0.060, 50, 1],
	&"death_heavy": [-5.0, 0.050, 90, 1],
	&"death_boss": [-2.0, 0.000, 600, 2],
	&"core_hit_light": [-5.0, 0.040, 100, 1],
	&"core_hit_heavy": [-3.0, 0.030, 100, 1],
	&"boss_stomp": [-3.0, 0.030, 300, 1],
	&"emp": [-3.0, 0.000, 400, 1],
	&"shield_up": [-5.0, 0.000, 300, 1],
	&"shield_break": [-4.0, 0.000, 300, 1],
	&"overdrive_on": [-4.0, 0.000, 300, 1],
	&"overdrive_off": [-5.0, 0.000, 300, 1],
	&"ui_tap": [-8.0, 0.010, 40, 2],
	&"ui_purchase": [-6.0, 0.000, 80, 2],
	&"ui_deny": [-6.0, 0.000, 150, 2],
	&"ui_drawer": [-8.0, 0.020, 120, 2],
	&"wave_start": [-3.0, 0.000, 500, 2],
	&"wave_clear": [-4.0, 0.000, 500, 2],
	&"intermission_tick": [-8.0, 0.000, 400, 2],
	&"core_low": [-3.0, 0.000, 700, 2],
	&"boss_stinger": [-1.0, 0.000, 2000, 2],
	&"victory": [-2.0, 0.000, 3000, 2],
	&"defeat": [-2.0, 0.000, 3000, 2],
}


static func has_sound(id: StringName) -> bool:
	return PARAMS.has(id)


static func volume_db(id: StringName) -> float:
	return _row(id)[0]


static func pitch_jitter(id: StringName) -> float:
	return _row(id)[1]


static func min_interval_ms(id: StringName) -> int:
	return _row(id)[2]


static func priority(id: StringName) -> int:
	return _row(id)[3]


## UI sounds keep working while the game is paused.
static func is_ui(id: StringName) -> bool:
	return String(id).begins_with("ui_")


static func sfx_path(id: StringName) -> String:
	return SFX_DIR + String(id) + ".wav"


## Null when the file is missing or not importable.
static func load_sfx(id: StringName) -> AudioStream:
	return load(sfx_path(id)) as AudioStream


static func _row(id: StringName) -> Array:
	var row: Array = PARAMS.get(id, [0.0, 0.0, 0, 0])
	return row
